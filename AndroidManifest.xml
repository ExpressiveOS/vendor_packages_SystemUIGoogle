<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.android.systemui"
    coreApp="true"
    android:sharedUserId="android.uid.systemui">

    <!-- Smartspace -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <protected-broadcast android:name="com.google.android.systemui.smartspace.CLICK_EVENT"/>
    <protected-broadcast android:name="com.google.android.systemui.smartspace.EXPIRE_EVENT"/>

    <!-- Ambient Indication -->
    <permission
        android:name="com.google.android.ambientindication.permission.AMBIENT_INDICATION"
        android:protectionLevel="signature|privileged"
        android:permissionFlags="allowedInPrivateComputeCore"/>
    <uses-permission android:name="com.google.android.ambientindication.permission.AMBIENT_INDICATION"/>

    <application
        android:appComponentFactory="com.google.android.systemui.SystemUIGoogleAppComponentFactory"
        tools:replace="android:appComponentFactory">

        <!-- Charging optimisation: Settings Intelligence binds this to apply "Limit to 80%".
             Callers are checked in code (privileged Settings Intelligence or system only). -->
        <service
            android:name="com.google.android.systemui.power.batteryhealth.HealthService"
            android:exported="true" />

        <!-- Re-applies "Limit to 80%" at boot through Google's battery HAL on phones
             without LineageOS charging control (Pixel 11 series). -->
        <receiver
            android:name="com.google.android.systemui.power.batteryhealth.ChargeLimitBootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
